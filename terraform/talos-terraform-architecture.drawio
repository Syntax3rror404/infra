    <mxCell id="g3" value="&lt;b&gt;Terraform CR &quot;talos&quot;&lt;/b&gt; (tofu-controller)&#xa;infra.contrib.fluxcd.io/v1alpha2&#xa;interval: 10m · approvePlan: auto&#xa;path: ./terraform/talos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane0">
