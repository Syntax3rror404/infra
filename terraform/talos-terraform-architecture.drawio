    <mxCell id="admin" value="&lt;b&gt;Admin-Zugriff&lt;/b&gt;&#xa;talosctl → Endpoints = 3 CP-IPs, Port 50000&#xa;(keine Default-Nodes: -n immer angeben)&#xa;kubectl → VIP :6443, OIDC-Kontext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane4">
