    <mxCell id="l1a" value="&lt;b&gt;terraform.tfvars&lt;/b&gt;&#xa;cluster_name = &lt;cluster&gt;&#xa;talos_version = 1.13.7&#xa;kubernetes_version = 1.36.3&#xa;endpoint_vip = 192.168.35.40&#xa;pod_subnet = 10.244.0.0/16&#xa;service_subnet = 10.245.0.0/16&#xa;default_gateway = 192.168.35.1&#xa;nameserver = 192.168.33.1&#xa;search_domain = &lt;search-domain&gt;&#xa;controlplanes[3] / workers[3]&#xa;talos_extensions[5] · oidc{...}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane1">
