    </mxCell>
    <mxCell id="g4" value="&lt;b&gt;tf-runner Pod&lt;/b&gt;&#xa;ServiceAccount tf-runner (flux-system)&#xa;nodeSelector + Toleration:&#xa;läuft nur auf Control-Plane-Nodes&#xa;führt init / plan / apply aus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane0">
