    <mxCell id="l1b" value="&lt;b&gt;variables.tf — Patch-Defaults&lt;/b&gt;&#xa;sysctls_patch:&#xa;· TCP BBR + fq qdisc, TFO, MTU probing&#xa;· rmem/wmem 64 MB, backlog/somaxconn&#xa;· inotify, vm.max_map_count, dirty ratios&#xa;· sunrpc slots, ip_local_port_range&#xa;sysfs_patch:&#xa;· RPS/RFS auf enp1s0 + enp2s0 (ffff)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane1">
