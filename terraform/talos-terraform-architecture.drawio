    <mxCell id="lane1" value="1 · Eingaben &amp; State" style="swimlane;html=1;startSize=40;horizontal=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=14;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="1">
