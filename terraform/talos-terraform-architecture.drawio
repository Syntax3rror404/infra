    <mxCell id="disknote" value="OS-Disk-Modell unterscheidet sich pro Node;&#xa;install_diskSelector adressiert das Modell,&#xa;nicht den Slot → Reihenfolge egal.&#xa;Daten-Disk ist überall identisch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;fontSize=11;" vertex="1" parent="lane4">
