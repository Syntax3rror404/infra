    <mxCell id="lane3" value="3 · Gerenderte Machine-Config (Patches)" style="swimlane;html=1;startSize=40;horizontal=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=14;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="1">
      <mxGeometry x="1220" y="140" width="440" height="1120" as="geometry"/>
    </mxCell>
    <mxCell id="p0" value="&lt;b&gt;Für alle 6 Nodes&lt;/b&gt;&#xa;· sysctls_patch + sysfs_patch&#xa;· kubelet: rotate-server-certificates&#xa;· /etc/cri/conf.d/20-customization.part&#xa;&#160;&#160;(discard_unpacked_layers = false)&#xa;· install: image = Factory-Installer,&#xa;&#160;&#160;wipe = true, diskSelector.model = OS-Disk&#xa;· features.hostDNS (forwardKubeDNSToHost)&#xa;· cluster.discovery: disabled&#xa;· cni: none · dnsDomain: cluster.local&#xa;· podSubnet / serviceSubnet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane3">
      <mxGeometry x="20" y="60" width="400" height="215" as="geometry"/>
    </mxCell>
    <mxCell id="p1" value="&lt;b&gt;Pro-Node-Patch (locals.tf, v1alpha1-Docs)&lt;/b&gt;&#xa;· HostnameConfig (auto: off, fester Hostname)&#xa;· ResolverConfig (Nameserver + Search-Domain)&#xa;· LinkConfig enp2s0: &lt;node-ip&gt;/24 + Gateway&#xa;· LinkConfig lo: 169.254.116.108/32&#xa;· UserVolumeConfig &quot;longhorn&quot;&#xa;&#160;&#160;diskSelector → NVMe-Datendisk, kein System-Disk&#xa;&#160;&#160;maxSize 1800 GB, Dateisystem xfs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane3">
      <mxGeometry x="20" y="300" width="400" height="175" as="geometry"/>
    </mxCell>
    <mxCell id="p2" value="&lt;b&gt;Nur Control Plane&lt;/b&gt;&#xa;· Layer2VIPConfig &lt;VIP&gt; auf enp2s0&#xa;· allowSchedulingOnControlPlanes: false&#xa;· proxy.disabled → kein kube-proxy (Cilium)&#xa;· coreDNS.disabled → CoreDNS via Flux&#xa;· apiServer: event-ttl 15m, env GOGC=75&#xa;· features.kubernetesTalosAPIAccess&#xa;&#160;&#160;Rollen os:reader, os:operator&#xa;&#160;&#160;nur Namespace kube-system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane3">
      <mxGeometry x="20" y="500" width="400" height="190" as="geometry"/>
    </mxCell>
    <mxCell id="p3" value="&lt;b&gt;OIDC-Patch (nur CP, wenn var.oidc gesetzt)&lt;/b&gt;&#xa;· Datei /var/etc/kubernetes/oidc/auth-config.yaml&#xa;&#160;&#160;AuthenticationConfiguration (jwt)&#xa;· apiServer: --authentication-config&#xa;· extraVolume hostPath → /etc/kubernetes/oidc (ro)&#xa;· username-Claim + Prefix oidc:&#xa;· groups-Claim + Prefix oidc:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane3">
      <mxGeometry x="20" y="715" width="400" height="165" as="geometry"/>
    </mxCell>
    <mxCell id="p4" value="&lt;b&gt;Bewusst NICHT hier verwaltet&lt;/b&gt;&#xa;CNI (Cilium), CoreDNS, kube-proxy-Ersatz,&#xa;Longhorn, Gateways → kommen komplett&#xa;über Flux, nicht über OpenTofu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane3">
      <mxGeometry x="20" y="905" width="400" height="110" as="geometry"/>
    </mxCell>

