    <mxCell id="lan" value="&lt;b&gt;LAN&lt;/b&gt; · 2,5-GbE-Switch · enp2s0&#xa;Gateway 192.168.35.1&#xa;DNS 192.168.33.1 (OPNsense/dnsmasq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="lane4">
